rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Athlete profiles + their results
    match /athletes/{athleteId} {
      // Anyone can view the leaderboard / search / profiles - no login needed.
      allow read: if true;

      // Only a signed-in coach account can add athletes or log results.
      allow write: if request.auth != null;
    }
  }
}
